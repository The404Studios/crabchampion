<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>UnrealSavEditor</AssemblyName>
    <RootNamespace>UnrealSavEditor</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>The404Studios</Authors>
    <Description>A beautiful SAV file editor for Unreal Engine games</Description>
  </PropertyGroup>

  <!-- Exclude CrabTrainer subfolder - it's a separate project -->
  <ItemGroup>
    <Compile Remove="CrabTrainer\**" />
    <Content Remove="CrabTrainer\**" />
    <EmbeddedResource Remove="CrabTrainer\**" />
    <None Remove="CrabTrainer\**" />
    <Page Remove="CrabTrainer\**" />
    <ApplicationDefinition Remove="CrabTrainer\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.77" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

</Project>
