<Window x:Class="UnrealSavEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UnrealSavEditor.ViewModels"
        xmlns:converters="clr-namespace:UnrealSavEditor.Converters"
        Title="{Binding WindowTitle}"
        Height="850" Width="1400"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- Simple Styles -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F97316"/>
        </Style>

        <Style x:Key="SubHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EA580C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#22D3EE"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveFileCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,20" BorderThickness="0,0,0,1" BorderBrush="#334155">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="50" Height="50" CornerRadius="12" Background="#F97316" Margin="0,0,16,0">
                        <TextBlock Text="🦀" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Crab Champions" Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="Save File Editor" Style="{StaticResource SubHeaderText}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="🎮 Open Game Save" Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenDefaultSaveCommand}" Margin="0,0,12,0"
                            Visibility="{Binding DefaultSaveExists, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="📁 Browse..." Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenFileCommand}" Margin="0,0,12,0"/>
                    <Button Content="💾 Save" Style="{StaticResource SecondaryButton}"
                            Command="{Binding SaveFileCommand}" IsEnabled="{Binding HasFile}" Margin="0,0,12,0"/>
                    <Button Content="📋 Backup" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CreateBackupCommand}" IsEnabled="{Binding HasFile}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Property Tree -->
            <Border Grid.Column="0" Background="#0F172A" BorderThickness="0,0,1,0" BorderBrush="#334155">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <Border Grid.Row="0" Padding="16">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </Border>

                    <!-- Tree View -->
                    <TreeView Grid.Row="1" ItemsSource="{Binding FilteredProperties}"
                              Background="Transparent" BorderThickness="0" Padding="8"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="4"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="4,4">
                                    <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="#F8FAFC"/>
                                        <TextBlock Text="{Binding DisplayValue}" FontSize="12" Foreground="#64748B"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                    </StackPanel>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasFile, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="🦀" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="Welcome, Champion!" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Open your SaveSlot.sav to begin" Style="{StaticResource SubHeaderText}"
                                   HorizontalAlignment="Center" Margin="0,8,0,24"/>

                        <Button Content="🎮 Load Game Save" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenDefaultSaveCommand}" HorizontalAlignment="Center"
                                Visibility="{Binding DefaultSaveExists, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Style="{StaticResource LabelText}" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap" MaxWidth="280">
                            Save location: %LocalAppData%\CrabChampions\Saved\SaveGames\
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Panel -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">

                    <!-- File Info Card -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FILE" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource BodyText}" FontWeight="Bold"
                                           Foreground="#F97316" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SIZE" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding FileSize}" Style="{StaticResource BodyText}" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COMPRESSION" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding CompressionType}" Style="{StaticResource BodyText}" FontWeight="Bold" Foreground="#22D3EE"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="PROPERTIES" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="{Binding PropertyCount}" Style="{StaticResource BodyText}" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quick Edit Section -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="⚡" FontSize="20" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Quick Edit Values" Style="{StaticResource BodyText}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="Modify numeric values directly" Style="{StaticResource LabelText}"/>
                                </StackPanel>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding QuickEditValues}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,12,12" Width="220">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Icon}" FontSize="20" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding CurrentValue, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ModernTextBox}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Apply" Style="{StaticResource PrimaryButton}" Padding="12,8"
                                                            Command="{Binding DataContext.ApplyQuickEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="MAX" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.MaxOutValueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- No values message -->
                            <TextBlock Text="Select a numeric property from the tree to edit, or load a save with detectable values."
                                       Style="{StaticResource LabelText}" TextWrapping="Wrap"
                                       Visibility="{Binding QuickEditValues.Count, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Property Editor Card -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Visibility="{Binding CanEditValue, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="✏️ Edit Selected Property" Style="{StaticResource BodyText}" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Style="{StaticResource LabelText}" Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProperty.Name}" Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" Style="{StaticResource LabelText}" Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProperty.TypeName}" Foreground="#22D3EE" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Value:" Style="{StaticResource LabelText}" Margin="0,0,0,12"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                                <Button Grid.Row="3" Grid.Column="1" Content="Apply Changes" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ApplyEditCommand}" HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Info Card -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ℹ️ Save File Information" Style="{StaticResource BodyText}" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Path:" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FilePath}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Save Class:" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SaveGameClass}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Engine:" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EngineVersion}" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Compression:" Style="{StaticResource LabelText}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CompressionType}" Style="{StaticResource BodyText}" Foreground="#22D3EE"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#0F172A" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="#334155">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,10,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#10B981"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Fill" Value="#F59E0B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                        <Setter Property="Fill" Value="#F59E0B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}"/>
                    <TextBlock Style="{StaticResource SubHeaderText}" Margin="16,0,0,0"
                               Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                        • Unsaved changes (Ctrl+S to save)
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Crab Champions Save Editor v1.0" Foreground="#F97316"/>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" Background="#E00F172A"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🦀" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Loading..." Style="{StaticResource HeaderText}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
